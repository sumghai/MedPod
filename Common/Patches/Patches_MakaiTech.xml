<?xml version="1.0" encoding="utf-8"?>

<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>MakaiTech</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>

				<!-- Prevent MedPods from treating various temporal injuries (outside context problem) -->
				
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[@Name="MedPodBedBase"]/comps/li[@Class="MedPod.CompProperties_TreatmentRestrictions"]/neverTreatableHediffs</xpath>
					<value>
						<li>Makai_TemporalBurn</li>
						<li>Makai_TemporalCut</li>
						<li>Makai_TemporalFrost</li>
					</value>
				</li>

			</operations>
		</match>
	</Operation>
</Patch>