<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
		<DebugType>embedded</DebugType>
		<AssemblyTitle>MedPod</AssemblyTitle>
		<Product>MedPod</Product>
		<Copyright>Copyright © 2026 sumghai. Licensed under CC BY-SA 4.0.</Copyright>
		<Version>1.0.0</Version>
		<LangVersion>latest</LangVersion>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<OutputPath>..\1.7\Assemblies\</OutputPath>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<OutputPath>..\1.7\Assemblies\</OutputPath>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Krafs.Publicizer" Version="2.3.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4985-unstable" />
		<PackageReference Include="Lib.Harmony" Version="3.0.0-rc.3" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="BadHygiene">
		  <HintPath>..\..\Dubs-Bad-Hygiene\1.7\Assemblies\BadHygiene.dll</HintPath>
		  <Private>False</Private>
		</Reference>
		<Reference Include="UnityStubs">
			<HintPath>..\..\..\UnityStubs.dll</HintPath>
		</Reference>
		<Reference Include="Waylith">
			<HintPath>..\..\..\Waylith.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<Publicize Include="Assembly-CSharp;" />
	</ItemGroup>
</Project>